<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="500" prefWidth="700" spacing="20" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProblemSelectionController">

    <Label style="-fx-font-size: 24px;" text="Lista de Problemas">
      <VBox.margin>
         <Insets top="15.0" />
      </VBox.margin></Label>

    <!-- Barra de búsqueda -->
    <HBox alignment="CENTER_LEFT" prefWidth="600" spacing="10">
        <Label text="Buscar: ">
         <HBox.margin>
            <Insets left="25.0" />
         </HBox.margin></Label>
        <TextField fx:id="searchField" promptText="Texto del problema..." />
        <Button onAction="#searchProblems" text="Buscar" />
      <Button mnemonicParsing="false" onAction="#clearSearch" text="Limpar" />
    </HBox>

    <!-- Lista de problemas -->
    <ListView fx:id="problemsList" prefHeight="350" prefWidth="600" />

    <HBox spacing="15">
        <Button onAction="#openProblem" prefWidth="150" text="Abrir problema">
         <HBox.margin>
            <Insets bottom="15.0" left="15.0" top="-5.0" />
         </HBox.margin></Button>
        <Button onAction="#goBack" prefWidth="120" text="Volver">
         <HBox.margin>
            <Insets left="380.0" top="-5.0" />
         </HBox.margin></Button>
    </HBox>

</VBox>
