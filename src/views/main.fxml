<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1400.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainController">
   <center>
      <VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="561.0" prefWidth="800.0">
         <children>
            <ScrollPane fx:id="map_scrollpane" hbarPolicy="ALWAYS" minHeight="-Infinity" minWidth="-Infinity" onMouseMoved="#showPosition" pannable="true" prefHeight="525.0" prefWidth="600.0" vbarPolicy="ALWAYS">
               <content>
                  <Pane>
                     <children>
                        <ImageView layoutY="14.0" pickOnBounds="true">
                           <image>
                              <Image url="@../resources/carta_nautica.jpg" />
                           </image>
                        </ImageView>
                        <MenuButton fx:id="map_pin" mnemonicParsing="false" prefHeight="60.0" prefWidth="48.0" visible="false">
                           <items>
                              <MenuItem fx:id="pin_info" mnemonicParsing="false" text="Action 1" />
                           </items>
                           <styleClass>
                              <String fx:value="menu-button" />
                              <String fx:value="map-pin" />
                           </styleClass>
                        </MenuButton>
                     </children>
                  </Pane>
               </content>
            </ScrollPane>
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Label fx:id="labelIntrucciones" text="Instrucciones herramientas" />
                  <Label text="Zoom">
                     <HBox.margin>
                        <Insets left="200.0" right="10.0" />
                     </HBox.margin>
                  </Label>
                  <Button minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#zoomOut" prefHeight="25.0" prefWidth="25.0" text="-" />
                  <Slider fx:id="zoom_slider" HBox.hgrow="SOMETIMES">
                     <HBox.margin>
                        <Insets left="10.0" right="10.0" />
                     </HBox.margin></Slider>
                  <Button minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#zoomIn" prefHeight="25.0" prefWidth="25.0" text="+">
                     <HBox.margin>
                        <Insets right="150.0" />
                     </HBox.margin>
                  </Button>
                  <Pane nodeOrientation="RIGHT_TO_LEFT" prefWidth="80.0" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                     <children>
                        <Label fx:id="mousePosition" alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" text="X: 0,   Y: 0" wrapText="true">
                           <padding>
                              <Insets left="6.0" top="2.0" />
                           </padding>
                        </Label>
                     </children>
                  </Pane>
               </children>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <top>
      <HBox alignment="CENTER_RIGHT" fillHeight="false" BorderPane.alignment="CENTER">
         <children>
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox alignment="TOP_CENTER" minWidth="-Infinity" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <GridPane alignment="CENTER" minHeight="-Infinity" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="101.33333587646484" minWidth="10.0" prefWidth="99.19999694824219" />
                  <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="113.60001373291016" minWidth="10.0" prefWidth="100.80000305175781" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                <Button fx:id="btnPoint" mnemonicParsing="false" onAction="#activatePointTool" text="Marcar punto" />
                  <Button fx:id="btnLine" mnemonicParsing="false" onAction="#activateLineTool" text="Trazar línea" GridPane.rowIndex="1" />
                  <Button fx:id="btnBorrar" alignment="CENTER" mnemonicParsing="false" onAction="#activateBorrar" text="Borrar" GridPane.rowIndex="4" />
                  <Slider fx:id="sliderGrosor" min="2.0" GridPane.columnSpan="2" GridPane.rowIndex="6">
                     <GridPane.margin>
                        <Insets left="15.0" right="15.0" />
                     </GridPane.margin>
                  </Slider>
                  <ColorPicker fx:id="colorPicker" GridPane.columnSpan="2" GridPane.rowIndex="5" />
                  <Button fx:id="btnBorrarTodo" mnemonicParsing="false" onAction="#activateBorrarTodo" text="Borrar todo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Button fx:id="btnArco" layoutX="21.0" layoutY="55.0" mnemonicParsing="false" onAction="#activateArcoTool" text="Trazar arco" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Button fx:id="btnSeleccionar" layoutX="16.0" layoutY="16.0" mnemonicParsing="false" onAction="#activateSeleccionarTool" text="Seleccionar" GridPane.columnIndex="1" />
                  <Button fx:id="btnTexto" layoutX="20.0" layoutY="48.0" mnemonicParsing="false" onAction="#activateTextTool" text="Añadir texto" GridPane.rowIndex="2" />
                  <Button fx:id="btnTransportador" layoutX="18.0" layoutY="89.0" mnemonicParsing="false" onAction="#activateTransportadorTool" text="Transp. ángulos" GridPane.rowIndex="3" />
                  <Button fx:id="btnRegla" layoutX="9.0" layoutY="130.0" mnemonicParsing="false" onAction="#activateReglaTool" text="Regla" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </GridPane>
            <Region prefHeight="30.0" prefWidth="200.0" />
            <Label text="Puntos del mapa">
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" top="10.0" />
               </VBox.margin>
            </Label>
            <ListView fx:id="map_listview" minHeight="-Infinity" onMouseClicked="#listClicked" prefHeight="195.0" prefWidth="200.0" />
         </children>
         <BorderPane.margin>
            <Insets left="10.0" right="10.0" top="20.0" />
         </BorderPane.margin>
      </VBox>
   </left>
   <right>
      <BorderPane BorderPane.alignment="CENTER">
         <bottom>
            <VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" prefHeight="110.0" prefWidth="300.0">
               <children>
                  <Button fx:id="randomProblem" mnemonicParsing="false" onAction="#generateRandomProblem" text="Generar problema aleatorio">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="problemsButton" alignment="BOTTOM_CENTER" mnemonicParsing="false" onAction="#openProblems" text="Seleccionar problema">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Button>
                  <Label fx:id="contadorProblemas" text="Contador problemas">
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
         </bottom>
         <top>
            <VBox alignment="TOP_CENTER" minWidth="-Infinity" prefWidth="300.0" BorderPane.alignment="CENTER">
               <children>
                  <Pane nodeOrientation="RIGHT_TO_LEFT">
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                     <children>
                        <MenuButton fx:id="profileMain" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" text=" username">
                          <items>
                            <MenuItem fx:id="profileButton" mnemonicParsing="false" onAction="#openProfile" text="Profile" />
                            <MenuItem fx:id="resultsButton" mnemonicParsing="false" onAction="#openResults" text="Histórico" />
                              <SeparatorMenuItem mnemonicParsing="false" />
                              <MenuItem mnemonicParsing="false" onAction="#logout" text="Cerrar sesión" />
                          </items>
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" nodeOrientation="RIGHT_TO_LEFT" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../resources/default.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </MenuButton>
                     </children>
                  </Pane>
                  <Label fx:id="tituloProbActual" text="Problema ##">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" top="5.0" />
                     </VBox.margin>
                  </Label>
                  <Label fx:id="enunciadoProblema" maxWidth="350.0" text="Enunciado" textAlignment="JUSTIFY" wrapText="true">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </Label>
                  <VBox>
                     <VBox.margin>
                        <Insets left="20.0" top="20.0" />
                     </VBox.margin>
                     <children>
                        <RadioButton fx:id="tBAlternativaA" mnemonicParsing="false" text="Alternativa A">
                           <toggleGroup>
                              <ToggleGroup fx:id="questionGroup" />
                           </toggleGroup>
                           <VBox.margin>
                              <Insets top="-10.0" />
                           </VBox.margin>
                        </RadioButton>
                        <RadioButton fx:id="tBAlternativaB" mnemonicParsing="false" text="Alternativa B" toggleGroup="$questionGroup" />
                        <RadioButton fx:id="tBAlternativaC" mnemonicParsing="false" text="Alternativa C" toggleGroup="$questionGroup" />
                        <RadioButton fx:id="tBAlternativaD" mnemonicParsing="false" text="Alternativa D" toggleGroup="$questionGroup" />
                     </children>
                  </VBox>
                  <Button fx:id="btnComprobarRespuesta" mnemonicParsing="false" onAction="#comprobarRespuesta" text="Comprobar respuesta">
                     <VBox.margin>
                        <Insets bottom="-20.0" top="10.0" />
                     </VBox.margin>
                  </Button>
                  <Label fx:id="textErrorCompResp" text="Selecciona una opción." textFill="RED" visible="false">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
         </top>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </BorderPane>
   </right>
</BorderPane>
