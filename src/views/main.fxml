                              <Button alignment="CENTER" contentDisplay="CENTER" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#zoomOut" prefHeight="30.0" prefWidth="30.0" style="-fx-border-color: -fx-gray-light;" text="-" textAlignment="CENTER"> 
