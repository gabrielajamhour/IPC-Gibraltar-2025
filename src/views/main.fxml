<BorderPane fx:id="pane" minHeight="-Infinity" minWidth="-Infinity" prefHeight="645.0" prefWidth="1450.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainController">
    <center>
      <StackPane>
