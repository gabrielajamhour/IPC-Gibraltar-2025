<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="500" prefWidth="700" spacing="20" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="controllers.ResultsController">

    <Label style="-fx-font-size: 24px;" text="Mis Resultados" />

    <!-- Filtro por fecha -->
    <HBox alignment="CENTER" spacing="10">
        <Label text="Filtrar desde fecha:" />
        <DatePicker fx:id="dateFilter" />
        <Button onAction="#applyFilter" text="Aplicar filtro" />
    </HBox>

    <!-- Tabla de sesiones -->
    <TableView fx:id="sessionsTable" prefHeight="350" prefWidth="600">
        <columns>
            <TableColumn fx:id="colDate" prefWidth="200" text="Fecha/Hora" />
            <TableColumn fx:id="colHits" prefWidth="150" text="Aciertos" />
            <TableColumn fx:id="colFaults" prefWidth="150" text="Fallos" />
        </columns>
    </TableView>

    <!-- Botón volver -->
    <Button alignment="CENTER" onAction="#goBack" prefWidth="120" text="Volver">
      <VBox.margin>
         <Insets bottom="20.0" />
      </VBox.margin></Button>

</VBox>
